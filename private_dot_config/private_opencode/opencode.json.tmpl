{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "renderdoc-mcp-server": {
      "type": "local",
      "command": [
        "renderdoc-mcp"
      ],
      "enabled": true
    }
  },
  "provider": {
{{- if eq .personal.location "unity-cn" }}
    "codely": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "codely proxy",
      "options": {
        "baseURL": "http://localhost:19191/v1",
      },
      "models": {
        "glm-5-fp8": {
          "name": "glm-5-fp8"
        },
        "glm-4.7-fp8": {
          "name": "glm-4.7-fp8"
        }
      }
    }
{{- end }}
  },
  "plugin": [
    "oh-my-opencode",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "tui": {
    "diff_style": "auto",
    "scroll_acceleration": {
      "enabled": true
    }
  }
}
