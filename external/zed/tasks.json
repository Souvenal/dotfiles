// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
  {
    "label": "[Souvenal] CMake Configure",
    "command": "cmake",
    "args": [
      "-B", "build",
      "-S", ".",
      "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "'-DCMAKE_POLICY_VERSION_MINIMUM=3.12'"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "[Souvenal] CMake Reconfigure",
    "command": "cmake",
    "args": [
      "-B", "build",
      "-S", ".",
      "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "'-DCMAKE_POLICY_VERSION_MINIMUM=3.12'",
      "--fresh"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "[Souvenal] CMake Build (Debug)",
    "command": "cmake",
    "args": [
      "--build", "build",
      "--config", "Debug"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "[Souvenal] CMake Build (Release)",
    "command": "cmake",
    "args": [
      "--build", "build",
      "--config", "Release"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "[Souvenal] CMake Clean Build",
    "command": "cmake",
    "args": [
      "--build", "build",
      "--target", "clean"
    ],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "[Souvenal] xmake generate compile_commands",
    "command": "xmake",
    "args": ["project", "-k", "compile_commands"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
