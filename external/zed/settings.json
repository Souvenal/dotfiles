// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "show_whitespaces": "selection",
  "use_system_window_tabs": false,
  "tabs": {
    "show_close_button": "hover",
    "show_diagnostics": "errors",
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": true,
    "show": true
  },
  "diagnostics": {
    "button": true
  },
  "debugger": {
    "button": true
  },
  "title_bar": {
    "show_menus": false,
    "show_user_menu": true,
    "show_user_picture": true,
    "show_branch_status_icon": true
  },
  "status_bar": {
    "show_active_file": false,
    "cursor_position_button": true,
    "line_endings_button": false,
    "active_encoding_button": "enabled"
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "ssh_connections": [
    {
      "host": "Souvenal-PC",
      "args": [],
      "projects": []
    }
  ],
  "edit_predictions": {
    "provider": "copilot",
    "allow_data_collection": "no",
    "open_ai_compatible_api": {
      "model": ""
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "single_file_review": true,
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "kimi": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
        "effort": "medium",
        "mode": "auto"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium"
      },
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    }
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "Consolas",
  "buffer_font_size": 15.0,
  "document_folding_ranges": "on",
  "document_symbols": "on",
  "file_finder": {
    "file_icons": true
  },
  "file_types": {
    "glsl": [
      "*.ush",
      "*.usf"
    ]
  },
  "format_on_save": "off",
  "git_panel": {
    "group_by": "status",
    "dock": "right",
    "tree_view": true
  },
  "gutter": {
    "line_numbers": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "languages": {
    "C++": {
      "format_on_save": "on",
      "indent_guides": {
        "coloring": "indent_aware"
      }
    }
  },
  "lsp": {
    "clangd": {"binary": {
      "path": "clangd"
    }}
  },
  "node": {
    "ignore_system_version": false
  },
  "project_panel": {
    "button": false,
    "dock": "right",
    "hide_root": false,
    "hide_hidden": false,
    "hide_gitignore": false
  },
  "proxy": "http://localhost:7890",
  "semantic_tokens": "combined",
  "terminal": {
    "button": false,
    "toolbar": {
      "breadcrumbs": false
    },
    "font_fallbacks": ["Consolas"],
    "font_family": "Hack Nerd Font Mono",
    "font_size": 14.0
  },
  "relative_line_numbers": "enabled",
  "theme": {
    "mode": "dark",
    "light": "Ayu Mirage",
    "dark": "Ayu Mirage",
  },
  "ui_font_size": 16.0,
  "vim": {
    "toggle_relative_line_numbers": true,
    "gdefault": false
  },
  "vim_mode": true
}
