// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-b": "workspace::ToggleLeftDock",
      "ctrl-alt-b": "workspace::ToggleRightDock",
      "ctrl-shift-b": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-shift-g": "git_panel::Toggle",
      "ctrl-shift-e": "project_panel::Toggle"
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "r": "project_panel::Rename",
      "shift+a": "project_panel::NewDirectory"
    },
    "unbind": {
      "%": "project_panel::NewFile"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-b": "editor::MoveLeft",
      "ctrl-alt-b": "editor::MoveToPreviousSubwordStart", // Ctrl-Alt-b -> toggle right dock
      "ctrl-shift-b": "editor::SelectLeft",
      "ctrl-e": "editor::MoveToEndOfLine",
      "ctrl-g": "go_to_line::Toggle",
    }
  },
  {
    "context": "VimControl",
    "bindings": {
      "ctrl-/": "editor::ToggleComments",
    },
    "unbind": {
      "ctrl-b": "vim::PageUp", // Ctrl-b -> toggle left dock
      "ctrl-e": "vim::LineDown",    // Ctrl-e -> open project panel
      "ctrl-g": "vim::ShowLocation"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-shift-c": "agent::ToggleNewThreadMenu"
    },
    "unbind": {
      "alt-cmd-shift-n": "agent::ToggleNewThreadMenu"
    }
  },
  {
    "context": "MarkdownPreview",
    "unbind": {
      "ctrl-e": "markdown::ScrollDown"
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-e": [
        "terminal::SendKeystroke",
        "ctrl-e"
      ]
    }
  },
  {
    "context": "Workspace && !Terminal",
    "bindings": {
      "alt-shift-t": [
        "task::Spawn",
        {
          "reveal_target": "center"
        }
      ]
    }
  },
  {
    "context": "KeymapEditor",
    "unbind": {
      "ctrl-e": "zed::OpenKeymapFile"
    }
  },
  {
    "context": "Workspace && !Terminal",
    "unbind": {
      "ctrl-alt-shift-r": [
        "task::Spawn",
        {
          "reveal_target": "center"
        }
      ]
    }
  },
  {
    "context": "Editor && extension == md",
    "bindings": {
      "ctrl-shift-v": "markdown::OpenPreview"
    }
  },
  {
    "context": "Editor && extension == md",
    "unbind": {
      "cmd-shift-v": "markdown::OpenPreview"
    }
  },
  {
    "bindings": {
      "ctrl-shift-d": "debug_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-shift-d": "debug_panel::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-g": "git_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-shift-e": [
        "editor::SelectToEndOfLine",
        {
          "stop_at_soft_wraps": true
        }
      ]
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-p": [
        "vim::Literal",
        [
          "ctrl-p",
          "\u0010"
        ]
      ]
    }
  },
  {
    "context": "GitCommit > Editor && mode == auto_height",
    "bindings": {
      "ctrl-shift-enter": "git::Amend"
    }
  },
  {
    "context": "GitCommit > Editor && mode == auto_height",
    "unbind": {
      "cmd-shift-enter": "git::Amend"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-shift-enter": "git::Amend"
    }
  },
  {
    "context": "GitPanel",
    "unbind": {
      "cmd-shift-enter": "git::Amend"
    }
  },
  {
    "context": "CommitEditor > Editor",
    "bindings": {
      "ctrl-shift-enter": "git::Amend"
    }
  },
  {
    "context": "CommitEditor > Editor",
    "unbind": {
      "cmd-shift-enter": "git::Amend"
    }
  },
  {
    "context": "GitDiff > Editor",
    "bindings": {
      "ctrl-shift-enter": "git::Amend"
    }
  },
  {
    "context": "GitDiff > Editor",
    "unbind": {
      "cmd-shift-enter": "git::Amend"
    }
  },
  {
    "context": "GitDiff > Editor",
    "bindings": {
      "ctrl-enter": "git::Commit"
    }
  },
  {
    "context": "GitDiff > Editor",
    "unbind": {
      "cmd-enter": "git::Commit"
    }
  },
  {
    "context": "CommitEditor > Editor",
    "bindings": {
      "ctrl-enter": "git::Commit"
    }
  },
  {
    "context": "CommitEditor > Editor",
    "unbind": {
      "cmd-enter": "git::Commit"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-enter": "git::Commit"
    }
  },
  {
    "context": "GitPanel",
    "unbind": {
      "cmd-enter": "git::Commit"
    }
  },
  {
    "context": "GitCommit > Editor && mode == auto_height",
    "bindings": {
      "ctrl-enter": "git::Commit"
    }
  },
  {
    "context": "GitCommit > Editor && mode == auto_height",
    "unbind": {
      "cmd-enter": "git::Commit"
    }
  },
  {
    "context": "Editor && mode == auto_height",
    "unbind": {
      "ctrl-shift-enter": "editor::NewlineBelow"
    }
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "ctrl-shift-enter": "workspace::OpenWithSystem"
    }
  },
  {
    "context": "InvalidBuffer",
    "unbind": {
      "ctrl-shift-enter": "workspace::OpenWithSystem"
    }
  },
  {
    "context": "Editor && jupyter",
    "unbind": {
      "ctrl-shift-enter": "repl::Run"
    }
  },
  {
    "bindings": {
      "ctrl-shift-o": "outline_panel::Toggle"
    }
  },
  {
    "context": "vim_mode == insert && !(showing_code_actions || showing_completions)",
    "unbind": {
      "ctrl-p": "editor::ShowWordCompletions"
    }
  },
  {
    "unbind": {
      "ctrl-p": "menu::SelectPrevious"
    }
  },
  {
    "context": "(vim_mode == insert || vim_mode == normal) && showing_signature_help && !showing_completions",
    "unbind": {
      "ctrl-p": "editor::SignatureHelpPrevious"
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-b": [
        "terminal::SendKeystroke",
        "ctrl-b"
      ]
    }
  }
]
