{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "[Souvenal] CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-S", ".",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "'-DCMAKE_POLICY_VERSION_MINIMUM=3.12'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "cmake",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^CMake (Error|Warning) at (.*):(\\d+):\\s*(.*)$",
                    "severity": 1,
                    "file": 2,
                    "line": 3,
                    "message": 4
                }
            },
            "group": "build"
        },
        {
            "label": "[Souvenal] CMake Reconfigure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-S", ".",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "'-DCMAKE_POLICY_VERSION_MINIMUM=3.12'",
                "--fresh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "cmake",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^CMake (Error|Warning) at (.*):(\\d+):\\s*(.*)$",
                    "severity": 1,
                    "file": 2,
                    "line": 3,
                    "message": 4
                }
            },
            "group": "build"
        },
        {
            "label": "[Souvenal] CMake Build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--config", "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "[Souvenal] CMake Build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--config", "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "[Souvenal] CMake Clean Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--target", "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build"
        }
    ]
}