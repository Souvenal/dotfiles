// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+b",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "true"
    },
    {
        "key": "ctrl+shift+b",
        "command": "workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "shift+cmd+v",
        "command": "-workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "ctrl+p",
        "command": "-list.focusUp",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "ctrl+p",
        "command": "-list.focusUp",
        "when": "inReferenceSearchEditor && neovim.mode == 'normal'"
    },
    {
        "key": "shift+enter",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b\r"
        },
        "when": "terminalFocus"
    },
    {
        "key": "tab",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\t"
        },
        "when": "terminalFocus"
    },
    {
        "key": "escape",
        "command": "workbench.action.terminal.sendSequence",
        "args": {
            "text": "\u001b"
        },
        "when": "terminalFocus"
    },
    {
        "key": "shift+alt+t",
        "command": "-clangd.typeHierarchy",
        "when": "editorTextFocus && resourceLangId == 'cpp' || editorTextFocus && resourceLangId == 'cuda-cpp' || editorTextFocus && resourceLangId == 'objective-c' || editorTextFocus && resourceLangId == 'objective-cpp'"
    },
    {
        "key": "shift+alt+t",
        "command": "workbench.action.tasks.runTask"
    }
]