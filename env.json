{
  "blocks": [
    {
      "block": "xdg",
      "comment": [
        "check https://wiki.archlinux.org.cn/title/XDG_Base_Directory for all software support",
        "XDG Base Directory"
      ],
      "env": [
        { "key": "XDG_CACHE_HOME", "value": "$HOME/.cache" },
        { "key": "XDG_CONFIG_HOME", "value": "$HOME/.config" },
        { "key": "XDG_DATA_HOME", "value": "$HOME/.local/share" },
        { "key": "XDG_STATE_HOME", "value": "$HOME/.local/state" }
      ]
    },
    {
      "block": "bash",
      "comment": ["bash"],
      "shell": ["bash"],
      "env": [
        { "key": "HISTFILE", "value": "$XDG_STATE_HOME/bash/history" }
      ]
    },
    {
      "block": "zsh",
      "comment": ["zsh"],
      "shell": ["zsh"],
      "env": [
        { "key": "ZSH", "value": "$XDG_DATA_HOME/oh-my-zsh" }
      ]
    },
    {
      "block": "docker",
      "comment": ["Docker"],
      "env": [
        { "key": "DOCKER_CONFIG", "value": "$XDG_CONFIG_HOME/docker" },
        { "key": "MACHINE_STORAGE_PATH", "value": "$XDG_DATA_HOME/docker-machine" }
      ]
    },
    {
      "block": "dotnet",
      "comment": ["dotnet"],
      "env": [
        { "key": "DOTNET_CLI_HOME", "value": "$XDG_DATA_HOME/dotnet" }
      ]
    },
    {
      "block": "go",
      "comment": ["go"],
      "env": [
        { "key": "GOPATH", "value": "$XDG_DATA_HOME/go" }
      ]
    },
    {
      "block": "gpg",
      "comment": ["GPG"],
      "env": [
        { "key": "GNUPGHOME", "value": "$XDG_DATA_HOME/gnupg" },
        { "key": "GPG_TTY", "value": "$(tty)" },
        { "key": "SSH_AUTH_SOCK", "value": "$(gpgconf --list-dirs agent-ssh-socket)" }
      ]
    },
    {
      "block": "gradle",
      "comment": ["Gradle"],
      "env": [
        { "key": "GRADLE_USER_HOME", "value": "$XDG_DATA_HOME/gradle" }
      ]
    },
    {
      "block": "nodejs",
      "comment": ["Node.js"],
      "env": [
        { "key": "NODE_REPL_HISTORY", "value": "$XDG_DATA_HOME/node_repl_history" }
      ]
    },
    {
      "block": "npm",
      "comment": ["npm"],
      "env": [
        { "key": "NPM_CONFIG_USERCONFIG", "value": "$XDG_CONFIG_HOME/npm/npmrc" }
      ]
    },
    {
      "block": "nuget",
      "comment": ["Nuget (partial)"],
      "env": [
        { "key": "NUGET_PACKAGES", "value": "$XDG_DATA_HOME/nuget/packages" }
      ]
    },
    {
      "block": "python",
      "comment": ["Python"],
      "env": [
        { "key": "PYTHON_HISTORY", "value": "$XDG_STATE_HOME/python_history" },
        { "key": "PYTHONPYCACHEPREFIX", "value": "$XDG_CACHE_HOME/python" },
        { "key": "PYTHONUSERBASE", "value": "$XDG_DATA_HOME/python" }
      ]
    },
    {
      "block": "vim",
      "comment": ["vim with XDG config"],
      "env": [
        { "key": "VIMINIT", "value": "let $MYVIMRC=\"$XDG_CONFIG_HOME/vim/vimrc\" | source $MYVIMRC" },
        { "key": "VIMDOTDIR", "value": "$XDG_CONFIG_HOME/vim" }
      ]
    },
    {
      "block": "wget",
      "comment": ["wget"],
      "env": [
        { "key": "WGETRC", "value": "$XDG_CONFIG_HOME/wgetrc" },
        { "key": "wget", "value": "wget --hsts-file=\"$XDG_STATE_HOME/wget-hsts\"", "type": "alias" }
      ]
    },
    {
      "block": "homebrew",
      "comment": ["Homebrew settings"],
      "condition": "[ -x \"$(which brew)\" ]",
      "env": [
        { "key": "BREW", "value": "$(which brew 2>/dev/null)", "type": "local" },
        { "key": "HOMEBREW_API_DOMAIN", "value": "https://mirrors.ustc.edu.cn/homebrew-bottles/api" },
        { "key": "HOMEBREW_BREW_GIT_REMOTE", "value": "https://mirrors.ustc.edu.cn/brew.git" },
        { "key": "HOMEBREW_CORE_GIT_REMOTE", "value": "https://mirrors.ustc.edu.cn/homebrew-core.git" },
        { "key": "HOMEBREW_BOTTLE_DOMAIN", "value": "https://mirrors.ustc.edu.cn/homebrew-bottles" },
        { "key": "HOMEBREW_PIP_INDEX_URL", "value": "https://mirrors.ustc.edu.cn/pypi/simple/" },
        { "key": "brew_shellenv", "value": "$($BREW shellenv)", "type": "eval" }
      ]
    },
    {
      "block": "cpp",
      "comment": ["C/C++ settings"],
      "env": [
        { "key": "CC", "value": "{{ .language.cpp.cc | quote }}" },
        { "key": "CXX", "value": "{{ .language.cpp.cxx | quote }}" },
        { "key": "CMAKE_GENERATOR", "value": "{{ .language.cpp.cmake_generator | quote }}" },
        { "key": "CMAKE_BUILD_PARALLEL_LEVEL", "value": "\n{{- if eq .chezmoi.os \"darwin\" -}}\n$(sysctl -n hw.ncpu)\n{{- else if eq .chezmoi.os \"linux\" -}}\n$(nproc)\n{{- else -}}\n8\n{{- end }}" }
      ]
    },
    {
      "block": "xmake",
      "comment": ["xmake with XDG config"],
      "env": [
        { "key": "XMAKE_PKG_CACHEDIR", "value": "$XDG_CACHE_HOME/xmake/cache" }
      ]
    },
    {
      "block": "dev",
      "comment": ["Dev config"],
      "env": [
        { "key": "DEV_SDK_ROOT", "value": "{{ .lib.dev_sdk_root | quote }}" },
        { "key": "PKG_CONFIG_PATH", "value": "{{ .lib.pkg_config_path | quote }}:$PKG_CONFIG_PATH" },
        { "key": "LLVM_ROOT", "value": "{{ .lib.llvm_root | quote }}" }
      ]
    },
    {
      "block": "llvm",
      "comment": ["LLVM cmake prefix path"],
      "condition": "[ -n \"$LLVM_ROOT\" ]",
      "env": [
        { "key": "CMAKE_PREFIX_PATH", "value": "$LLVM_ROOT${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}" }
      ]
    },
    {
      "block": "sdk",
      "comment": ["vcpkg and Vulkan SDK"],
      "condition": "[ -d \"$DEV_SDK_ROOT\" ]",
      "env": [
        { "key": "VCPKG_ROOT", "value": "$DEV_SDK_ROOT/vcpkg" },
        { "key": "VULKAN_SDK_VERSION", "value": "{{ .lib.vulkan_sdk_version }}" },
        { "key": "VULKAN_SDK_ROOT", "value": "$DEV_SDK_ROOT/VulkanSDK/$VULKAN_SDK_VERSION" },
        { "key": "source_vulkan", "value": "source \"$VULKAN_SDK_ROOT/setup-env.sh\"", "type": "source", "condition": "[ -f \"$VULKAN_SDK_ROOT/setup-env.sh\" ]" }
      ]
    }
  ]
}
